{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["cargo", "dockerfile", "github-actions", "homeassistant-manifest", "pip_requirements", "rust-toolchain"],
  "mode": "full",
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "automerge": true,
  "automergeSchedule": ["at any time"],
  "osvVulnerabilityAlerts": true,
  "timezone": "UTC",
  "schedule": ["at any time"],
  "minimumReleaseAge": null,
  "prConcurrentLimit": 3,
  "platformAutomerge": false,
  "automergeType": "pr",
  "ignoreTests": false,
  "pinDigests": true,
  "rebaseWhen": "behind-base-branch",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Keep the Matrix SDK and crypto test dependency in sync",
      "matchPackageNames": ["/^matrix-sdk($|-)/"],
      "groupName": "Matrix Rust SDK"
    },
    {
      "matchManagers": ["pip_requirements", "homeassistant-manifest"],
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The action reads Rust from rust-toolchain.toml; do not rewrite its expression",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["rust"],
      "enabled": false
    },
    {
      "matchManagers": ["rust-toolchain"],
      "groupName": "Rust toolchain"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["rust", "docker.io/library/rust"],
      "groupName": "Rust toolchain"
    },
    {
      "description": "All dependency updates, including major and security updates, are CI-gated without manual approval",
      "matchPackageNames": ["*"],
      "dependencyDashboardApproval": false,
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"],
    "dependencyDashboardApproval": false,
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "automerge": true
  }
}
